alias -s org=emacs
em() {
    emacsclient -s doom -c "$@" 2>/dev/null || (emacs --init-directory=~/.config/emacs --daemon=doom && emacsclient -s doom -c "$@")
}
emt() {
    emacsclient -s doom -t "$@" 2>/dev/null || (emacs --init-directory=~/.config/emacs --daemon=doom && emacsclient -s doom -t "$@")
}
alias ec='emacsclient -s doom -c -n'                        # Quick new frame
alias killem='emacsclient -s doom -e "(kill-emacs)"'        # Force kill daemon (no prompts)
checkemacs() {
    echo "Checking Emacs daemon status..."
    if ps aux | grep -E "emacs.*daemon" | grep -v grep > /dev/null; then
        echo "✓ Daemon(s) running:"
        ps aux | grep -E "emacs.*daemon" | grep -v grep | awk '{print "  PID " $2 ": " $11 " " $12 " " $13}'
        echo ""
        echo "Try: ec (to open new frame)"
    else
        echo "✗ No daemon running"
        echo "Run: em (to start daemon and open frame)"
    fi
}
restartem() {
    echo "Killing Emacs daemon..."
    emacsclient -s doom -e "(kill-emacs)" 2>/dev/null || killall Emacs
    sleep 1
    echo "Starting fresh daemon..."
    emacs --init-directory=~/.config/emacs --daemon=doom
    echo "Done! Use 'ec' or 'em' to open a new frame"
}
