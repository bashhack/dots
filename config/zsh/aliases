# Shell switching
switchfish() {
    local fish_path=$(command -v fish)

    if [[ -z "$fish_path" ]]; then
        echo "❌ fish not found! Install with: brew install fish"
        return 1
    fi

    # Check if fish is in /etc/shells
    if ! grep -q "^${fish_path}$" /etc/shells; then
        echo "⚠️  fish is not in /etc/shells yet"
        echo "   Adding it now (requires sudo)..."
        echo ""
        echo "$fish_path" | sudo tee -a /etc/shells > /dev/null

        if [[ $? -ne 0 ]]; then
            echo "❌ Failed to add fish to /etc/shells"
            return 1
        fi
        echo "✅ Added fish to /etc/shells"
        echo ""
    fi

    echo "🔄 Switching default shell to fish..."
    echo "   Path: $fish_path"
    echo ""
    echo "⚠️  You may be prompted for your password again"

    chsh -s "$fish_path"

    if [[ $? -eq 0 ]]; then
        echo "✅ Default shell changed to fish"
        echo "   Restart your terminal or open a new window to use fish"
        echo ""
        echo "💡 To switch back to zsh, run: switchzsh"
    else
        echo "❌ Failed to change shell"
        return 1
    fi
}

# Try fish in tmux session (safe way to experiment)
tryfish() {
    if ! command -v fish &>/dev/null; then
        echo "❌ fish not found! Install with: brew install fish"
        return 1
    fi

    echo "🐟 Starting new tmux session with fish..."
    tmux new-session -s fish-trial fish
}

